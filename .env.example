# ===== AI (bắt buộc để AI chạy trực tiếp khi demo) =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://rs6esw8.abc-tunnel.us/v1
OPENAI_MODEL=cx/gpt-6-luna(xhigh)
# Decision chỉ lọc nhiễu và phân loại; khóa OpenRouter tách với khóa model chính.
OPENROUTER_API_KEY=
MSTUDENT_DECISION_MODEL=google/gemini-decision-1
MSTUDENT_DECISION_ENABLED=1
# =1 để ép chạy bằng bộ luật, không gọi API (chỉ dùng khi mất mạng)
MSTUDENT_OFFLINE=0

# ===== Bảo mật =====
# Khoá ký JWT + mã hoá token Google, >= 32 ký tự. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Để trống khi chạy local: server tự sinh và lưu vào backend/.secret_key
MSTUDENT_SECRET_KEY=
# Email được sửa prompt/model, chạy eval, xem audit log (phân tách bằng dấu phẩy)
MSTUDENT_ADMIN_EMAILS=
# open | closed — đóng đăng ký sau khi đã tạo đủ tài khoản demo
MSTUDENT_REGISTRATION=open
# dev | prod — prod tắt /docs và bắt buộc MSTUDENT_SECRET_KEY
MSTUDENT_ENV=dev
# Chỉ cần khi có web khác origin gọi API (vd. Expo web: http://localhost:8081). App native không cần.
MSTUDENT_CORS_ORIGINS=
MSTUDENT_ACCESS_TTL_MIN=15
MSTUDENT_REFRESH_TTL_DAYS=30

# ===== Google Cloud (console.cloud.google.com) — xem docs/GOOGLE_CLOUD_SETUP.md =====
# OAuth client loại "Web application": dùng để kiểm ID token và đổi mã lấy quyền Gmail
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth client loại "iOS" (ID token từ iPhone có aud là client này)
GOOGLE_IOS_CLIENT_ID=
# Client ID khác được chấp nhận, nếu có (phân tách bằng dấu phẩy)
GOOGLE_EXTRA_CLIENT_IDS=

# ===== Khác =====
MSTUDENT_DB=mstudent.db
# Cố định "bây giờ" để demo dữ liệu mẫu ổn định (bỏ trống = giờ thật)
MSTUDENT_NOW=
