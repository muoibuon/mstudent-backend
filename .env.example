OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Đặt =1 để ép chạy offline (luật), không gọi API
MSTUDENT_OFFLINE=0
# Cố định "bây giờ" cho demo ổn định (bỏ trống = giờ thật)
MSTUDENT_NOW=2026-11-10T08:00:00+07:00
MSTUDENT_DB=mstudent.db
# Email (tuỳ chọn)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Bảo vệ API khi deploy công khai cho app mobile (để trống = không cần token)
MSTUDENT_API_TOKEN=
# Chỉ cho phép token này sửa cấu hình agent (tab Cấu hình); để trống = ai cũng sửa được
MSTUDENT_ADMIN_TOKEN=
# Origin được phép gọi API (CORS); mặc định * cho demo
MSTUDENT_CORS_ORIGINS=*
