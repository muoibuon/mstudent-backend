# Cấu hình production — chép thành /etc/mstudent.env (chmod 600, chủ sở hữu: mstudent).
# KHÔNG commit file thật. Dòng nào không dùng thì để trống.

# ===== Bắt buộc (thiếu là server không khởi động) =====
MSTUDENT_ENV=prod
# Tạo: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MSTUDENT_SECRET_KEY=
OPENAI_API_KEY=
# Email admin, phân tách bằng dấu phẩy
MSTUDENT_ADMIN_EMAILS=

# ===== Dữ liệu & mạng =====
MSTUDENT_DB=/opt/mstudent/data/mstudent.db
# =1 vì chạy sau đường hầm trên chính máy này (lấy IP thật từ X-Forwarded-For)
MSTUDENT_TRUST_PROXY=1
MSTUDENT_REGISTRATION=open

# ===== AI & chi phí =====
OPENAI_BASE_URL=https://rs6esw8.abc-tunnel.us/v1
OPENAI_MODEL=cx/gpt-6-luna(xhigh)
# Model lọc nhiễu/phân loại qua OpenRouter, độc lập với Google OAuth nguồn dữ liệu.
OPENROUTER_API_KEY=
MSTUDENT_DECISION_MODEL=google/gemini-decision-1
# =0 bỏ qua Decision, dùng Triage → Extractor bằng LLM chính.
MSTUDENT_DECISION_ENABLED=1
# Trần chi phí LLM mỗi ngày (USD) cho toàn hệ thống; chạm trần → chạy bộ luật tới hết ngày
MSTUDENT_LLM_DAILY_USD=5
# Trần riêng mỗi người dùng mỗi ngày (USD): một người không đốt hết trần chung của mọi người. 0 = tắt
MSTUDENT_LLM_USER_DAILY_USD=0.5
# Giá dùng ƯỚC TÍNH ngân sách, không phải hóa đơn gateway; xác nhận giá trước khi dùng số USD báo cáo.
MSTUDENT_PRICE_IN_PER_M=0.10
MSTUDENT_PRICE_OUT_PER_M=0.50
# Giây chờ tối đa cho một lượt gọi LLM
MSTUDENT_LLM_TIMEOUT_S=25
# Webhook nhận cảnh báo chi phí 80% / 100% (Discord, Slack…). Trống = không gửi
MSTUDENT_ALERT_WEBHOOK=

# ===== Đồng bộ tự động (Gmail, Classroom, bảng lớp, lịch LMS) =====
MSTUDENT_SYNC_ENABLED=1
# Kiểm tra Gmail định kỳ (giây) khi chưa có / lỗi Pub/Sub
MSTUDENT_GMAIL_POLL_S=120
MSTUDENT_SYNC_CONCURRENCY=4
# Địa chỉ HTTPS công khai của máy chủ (Tailscale Funnel), vd https://mstudent.xxx.ts.net
MSTUDENT_PUBLIC_URL=
# Gmail báo ngay (tuỳ chọn): topic Pub/Sub và service account ký JWT của push subscription
MSTUDENT_PUBSUB_TOPIC=
MSTUDENT_PUBSUB_PUSH_SA=

# ===== Google (tuỳ chọn) — xem docs/GOOGLE_CLOUD_SETUP.md =====
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_EXTRA_CLIENT_IDS=

# KHÔNG đặt MSTUDENT_NOW ở production.
# Chưa có OPENAI_API_KEY (hoặc cần đường lui khi provider chính lỗi): đặt MSTUDENT_OFFLINE=1 để chạy bộ luật.
# Có khoá rồi thì xoá dòng này và chạy: sudo systemctl restart mstudent
MSTUDENT_OFFLINE=
