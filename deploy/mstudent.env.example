# Cấu hình production — chép thành /etc/mstudent.env (chmod 600, chủ sở hữu: mstudent).
# KHÔNG commit file thật. Dòng nào không dùng thì để trống.

# ===== Bắt buộc (thiếu là server không khởi động) =====
MSTUDENT_ENV=prod
# Tạo: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MSTUDENT_SECRET_KEY=
OPENAI_API_KEY=
# Email admin, phân tách bằng dấu phẩy
MSTUDENT_ADMIN_EMAILS=

# ===== Dữ liệu & mạng =====
MSTUDENT_DB=/opt/mstudent/data/mstudent.db
# =1 vì chạy sau đường hầm trên chính máy này (lấy IP thật từ X-Forwarded-For)
MSTUDENT_TRUST_PROXY=1
MSTUDENT_REGISTRATION=open

# ===== AI & chi phí =====
OPENAI_MODEL=gpt-5-mini
# Trần chi phí LLM mỗi ngày (USD) cho toàn hệ thống; chạm trần → chạy bộ luật tới hết ngày
MSTUDENT_LLM_DAILY_USD=5
# Đơn giá USD / 1 triệu token của model đang dùng (đổi model thì đổi giá)
MSTUDENT_PRICE_IN_PER_M=0.25
MSTUDENT_PRICE_OUT_PER_M=2.0
# Giây chờ tối đa cho một lượt gọi LLM
MSTUDENT_LLM_TIMEOUT_S=25
# Webhook nhận cảnh báo chi phí 80% / 100% (Discord, Slack…). Trống = không gửi
MSTUDENT_ALERT_WEBHOOK=

# ===== Google (tuỳ chọn) — xem docs/GOOGLE_CLOUD_SETUP.md =====
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_EXTRA_CLIENT_IDS=

# KHÔNG đặt MSTUDENT_NOW và MSTUDENT_OFFLINE ở production.
